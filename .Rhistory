presence_summary <- presence_df2 %>%
mutate(
Category = case_when(
iNaturalist == "Yes" & EDDMapS == "Yes" ~ "Both platforms",
iNaturalist == "Yes" & EDDMapS == "No" ~ "iNaturalist only",
iNaturalist == "No"  & EDDMapS == "Yes" ~ "EDDMapS only",
TRUE ~ "Neither"
)
